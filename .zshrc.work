export ANDROID_HOME=$HOME/.android
if [[ -d $ANDROID_HOME ]]; then
  path+=("$ANDROID_HOME/cmdline-tools/latest/bin" "$ANDROID_HOME/platform-tools" "$ANDROID_HOME/emulator")
fi

if (( $+commands[mapbox] )); then
  eval "$(mapbox completion zsh)"
fi

if (( $+commands[npm] )); then
  NPM_ROOT=$(npm root -g)
  [[ -r "$NPM_ROOT/@mapbox/mbxcli/bin/mapbox.sh" ]] && source "$NPM_ROOT/@mapbox/mbxcli/bin/mapbox.sh"
fi
